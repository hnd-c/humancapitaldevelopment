# Human Capital Development Backend - Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# ENVIRONMENT SETTINGS
# =============================================================================
ENVIRONMENT=development  # Options: development, staging, production, test
DEBUG=true

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL Database Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=human_capital_dev
DB_USER=hcd_user
DB_PASSWORD=your_secure_password_here

# Database Connection Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# Redis Cache Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_DECODE_RESPONSES=false
REDIS_SOCKET_TIMEOUT=30
REDIS_CONNECT_TIMEOUT=30
REDIS_MAX_CONNECTIONS=50

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# JWT Settings
JWT_SECRET_KEY=your_jwt_secret_key_at_least_32_characters_long
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# API Security
SECURITY_ENABLE_CORS=true
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
SECURITY_ENABLE_RATE_LIMITING=true
SECURITY_ENABLE_REQUEST_LOGGING=true
SECURITY_API_KEY_REQUIRED=false

# =============================================================================
# MACHINE LEARNING CONFIGURATION
# =============================================================================
# ML Model Settings
ML_USE_MULTIMODAL=true
ML_SIMILARITY_THRESHOLD=0.7
ML_TRANSITION_ALPHA=0.1
ML_MAX_RECOMMENDATIONS=50
ML_DIVERSITY_THRESHOLD=0.8

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================
# Cache TTL Settings (in seconds)
CACHE_DEFAULT_TTL=600
CACHE_RECOMMENDATION_TTL=1800
CACHE_PROFILE_TTL=900
CACHE_SIMILARITY_TTL=3600
CACHE_EMBEDDINGS_TTL=7200
CACHE_ENABLE_WARMING=true
CACHE_WARMING_BATCH_SIZE=100
CACHE_MAX_MEMORY_RATIO=0.8

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================
# Performance Monitoring
PERF_ENABLE_MONITORING=true
PERF_MAX_CONCURRENT_USERS=1000
PERF_REQUEST_TIMEOUT=30
PERF_RATE_LIMIT=60
PERF_DETAILED_LOGGING=false
LOG_LEVEL=INFO
PERF_METRICS_RETENTION=7

# =============================================================================
# FILE PATHS
# =============================================================================
# Application Paths
DATA_PATH=.
LOGS_PATH=logs

# =============================================================================
# STAGING ENVIRONMENT VARIABLES
# =============================================================================
# Uncomment and configure for staging environment
# STAGING_DB_HOST=staging-db.example.com
# STAGING_DB_PORT=5432
# STAGING_DB_NAME=human_capital_staging
# STAGING_DB_USER=hcd_staging
# STAGING_DB_PASSWORD=staging_secure_password
# STAGING_REDIS_HOST=staging-redis.example.com
# STAGING_REDIS_PORT=6379
# STAGING_REDIS_DB=0
# STAGING_REDIS_PASSWORD=staging_redis_password
# STAGING_JWT_SECRET=staging_jwt_secret_key_at_least_32_characters

# =============================================================================
# PRODUCTION ENVIRONMENT VARIABLES
# =============================================================================
# Required for production environment
# PROD_DB_HOST=prod-db.example.com
# PROD_DB_PORT=5432
# PROD_DB_NAME=human_capital_prod
# PROD_DB_USER=hcd_prod
# PROD_DB_PASSWORD=production_secure_password
# PROD_REDIS_HOST=prod-redis.example.com
# PROD_REDIS_PORT=6379
# PROD_REDIS_DB=0
# PROD_REDIS_PASSWORD=production_redis_password
# PROD_JWT_SECRET=production_jwt_secret_key_at_least_32_characters

# AWS S3 Configuration (Production)
# S3_BUCKET_NAME=your-s3-bucket-name
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# =============================================================================
# TEST ENVIRONMENT VARIABLES
# =============================================================================
# Test Database Settings
# TEST_DB_PASSWORD=test_secure_password

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
# Add any external service configurations here
# OPENAI_API_KEY=your_openai_api_key
# MONITORING_SERVICE_URL=https://monitoring.example.com
# NOTIFICATION_SERVICE_URL=https://notifications.example.com

# =============================================================================
# DEVELOPMENT NOTES
# =============================================================================
# 1. Never commit the actual .env file to version control
# 2. Use strong passwords and secrets (minimum 32 characters for JWT secrets)
# 3. For production, ensure all PROD_* variables are set
# 4. Test your configuration with: python -c "from config.config import load_config_for_environment; print('Config loaded successfully')"
